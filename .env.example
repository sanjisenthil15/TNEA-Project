# =============================================================
# TNEA Career Insight Navigator — Environment Configuration
# =============================================================

# Flask Secret Key for session management
SECRET_KEY=your-super-secret-key-here

# Google Gemini / OpenAI AI Configuration
# For Google Gemini, provide your Gemini API key (e.g. from Google AI Studio)
GEMINI_API_KEY=
GEMINI_API_KEY_2=

# OpenAI Compatibility Variables (automatically routed to Google Generative Language)
OPENAI_API_KEY=
FALLBACK_AI_API_KEY=
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Stable Supported Gemini Models
OPENAI_MODEL=gemini-3.8-flash
FALLBACK_AI_MODEL=gemini-3.5-flash-lite

# Web Search / Tavily API Key (Optional)
TAVILY_API_KEY=

